{
  "openai_economical": {
    "provider": "openai",
    "model": "gpt-5.6-luna",
    "api_key_env": "OPENAI_API_KEY",
    "max_output_tokens": 256,
    "reasoning_effort": "none"
  },
  "openai_frontier": {
    "provider": "openai",
    "model": "gpt-6-astra",
    "api_key_env": "OPENAI_API_KEY",
    "max_output_tokens": 1024,
    "reasoning_effort": "low"
  },
  "jev_openrouter": {
    "provider": "jev",
    "model": "typesafe/jev-1.13",
    "base_url": "https://openrouter.ai/api/v1",
    "api_key_env": "OPENROUTER_API_KEY",
    "timeout": 120
  }
}
